# X-LiveCast configuration. Copy to .env and fill in values.
# Everything runs locally; the key is only used on this machine (localhost).

# Required: Gemini API key (free). Get one at https://aistudio.google.com/apikey
# No billing setup needed to use the free tier.
GEMINI_API_KEY=your-gemini-key-here

# Local voice-room server port.
XLC_PORT=8787

# Gemini Live (audio-to-audio) model. Latest first. If one errors with
# "model not found" or is rate-limited, try the next:
#   gemini-3.1-flash-live-preview   (latest)
#   gemini-2.5-flash-live-preview
# Note: gemini-2.0-flash-live-001 is SHUT DOWN — do not use.
XLC_GEMINI_MODEL=gemini-3.1-flash-live-preview

# Prebuilt voice: Puck, Charon, Kore, Fenrir, Aoede.
XLC_GEMINI_VOICE=Puck

# --- X credentials do NOT go here. ---
# X auth is handled by the official `xurl` CLI, which stores tokens in ~/.xurl.
# Set it up once:
#   brew install --cask xdevplatform/tap/xurl
#   xurl auth oauth2 --app my-app     (or: xurl auth oauth1 ...)
# See README "Connect live X data" for the full steps.
