# X-LiveCast configuration. Copy to `.env` and fill in values.
# Runtime data paths / sessions / drafts / memory → references/local-layout.md

# --- Required ---
# Free key: https://aistudio.google.com/apikey  (used only on the host)
GEMINI_API_KEY=your-gemini-key-here

# --- Room ---
XLC_PORT=8787
# Live audio model (if 404 / rate-limit, try the next):
#   gemini-3.1-flash-live-preview
#   gemini-2.5-flash-live-preview
XLC_GEMINI_MODEL=gemini-3.1-flash-live-preview
# Voice: Puck | Charon | Kore | Fenrir | Aoede
XLC_GEMINI_VOICE=Puck
# Text model for Synthesize (not Live audio)
# XLC_SYNTH_MODEL=gemini-2.5-flash
# XLC_NO_BROWSER=1

# --- Always-on (optional) ---
# Evergreen HTTPS front door; cron/DM reuse this URL.
# Render: references/render.setup.md  |  Tunnel/VPS: references/always-on.setup.md
# XLC_PUBLIC_URL=https://livecast.example.com
# XLC_TUNNEL_MODE=named   # named | quick | none  (Render: none)
# XLC_ROOM_TOKEN=change-me
# Persistent volume root (Render disk mount). Local default = repo root.
# XLC_DATA_DIR=/var/data
# PaaS also sets PORT; voice_room prefers PORT over XLC_PORT.

# --- X auth is NOT here ---
# xurl stores tokens in ~/.xurl
#   brew install --cask xdevplatform/tap/xurl
#   xurl auth oauth2 --app my-app    # read / DM
#   xurl auth oauth1 --app my-app    # often needed for tweet.write / publish
#
# Edit taste in markdown (not env): prompt.md, recap_template.md, memory/USER.md, memory/TASTE.md
# Checklist: TESTING.md · Skill recipes: SKILL.md
