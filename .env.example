# X-LiveCast configuration. Copy to `.env` and fill in values.
# Runtime data paths / sessions / drafts / memory → references/local-layout.md

# --- Required ---
# Free key: https://aistudio.google.com/apikey  (used only on the host)
GEMINI_API_KEY=your-gemini-key-here

# --- Room ---
XLC_PORT=8787
# Live audio model (if 404 / rate-limit, try the next):
#   gemini-3.1-flash-live-preview
#   gemini-2.5-flash-live-preview
XLC_GEMINI_MODEL=gemini-3.1-flash-live-preview
# Voice: Puck | Charon | Kore | Fenrir | Aoede
XLC_GEMINI_VOICE=Puck
# Text model for Synthesize + Generate brief (not Live audio).
# Distinct from XLC_GEMINI_MODEL (voice Live). Also set this on Render Environment.
XLC_SYNTH_MODEL=gemini-3.5-flash
# XLC_NO_BROWSER=1

# Memory evolve after Synthesize: suggest (UI Apply) | auto | off
# XLC_MEMORY_EVOLVE=suggest

# --- Always-on (optional) ---
# Evergreen HTTPS front door; cron/DM reuse this URL.
# Render: references/render.setup.md  |  Tunnel/VPS: references/always-on.setup.md
# XLC_PUBLIC_URL=https://livecast.example.com
# XLC_TUNNEL_MODE=named   # named | quick | none  (Render: none)
# XLC_ROOM_TOKEN=change-me
# Shared secret for daily cron → POST /brief/generate (see references/daily-brief.cron.md)
# XLC_CRON_SECRET=change-me-long-random
# XLC_BRIEF_TZ=America/New_York
# XLC_BRIEF_HOUR=8
# Persistent volume root (Render disk mount). Local default = repo root.
# XLC_DATA_DIR=/var/data
# On Render: set HOME in Start Command (not as a service env var — build can't
# write /var/data). See references/render.setup.md.
# PaaS also sets PORT; voice_room prefers PORT over XLC_PORT.

# --- X / xurl (not secrets — tokens live in ~/.xurl) ---
# brew install --cask xdevplatform/tap/xurl
#   or: curl -fsSL https://raw.githubusercontent.com/xdevplatform/xurl/main/install.sh | bash
# xurl auth oauth2 --app my-app    # read / DM / bookmarks
# xurl auth oauth1 --app my-app    # often needed for tweet.write / publish
# Optional overrides when PATH is weird (GUI apps, Render):
# XLC_XURL_BIN=/home/render/.local/bin/xurl
# XLC_XURL_APP=my-app
#
# Edit taste in markdown (not env): prompt.md, recap_template.md, memory/USER.md, memory/TASTE.md
# Checklist: TESTING.md · Skill recipes: SKILL.md · Cloud: references/render.setup.md
